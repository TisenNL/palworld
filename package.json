{
  "name": "palworld-checklist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s typecheck build:only",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write src tests *.config.ts package.json tsconfig*.json",
    "test": "vitest run",
    "test:server": "py -3 -m unittest tests.test_game_marker_automation tests.test_progress_persistence",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:images": "py -3 tools/validate_image_urls.py",
    "validate": "run-s typecheck lint test test:server build:only"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "leaflet": "1.9.4",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.9",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.14",
    "@types/node": "24.3.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.35.0",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.3.0",
    "happy-dom": "20.14.5",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "^3.0.6"
  }
}
